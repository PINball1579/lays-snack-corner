# Copy to .env.deploy and fill in. .env.deploy is gitignored — it holds
# server credentials and must never be committed.
#
# Target: the DigitalOcean Droplet provisioned by provision.sh, fronted by
# Cloudflare (origin locked to Cloudflare's published IP ranges; see
# provision.sh's firewall section). SSH as root (or a sudo-capable deploy
# user you created yourself) directly to the Droplet's IP -- find the IP on
# the Droplet's page in the DigitalOcean control panel (Networking tab).
# There is no Cloudways-style master/application account here.

# ssh target: user@droplet-ip, e.g. root@203.0.113.10
LAYS_REMOTE_HOST="root@YOUR_DROPLET_IP"

# Apache document root written by provision.sh's setup_docroot step —
# must match DOCROOT in provision.sh (/var/www/<domain>). Do not add a
# trailing slash; deploy.sh and set-link.sh both append their own.
LAYS_REMOTE_PATH="/var/www/laysmortorlor.com"

# Public origin used by set-link.sh to verify a link change actually went
# live, and by verify-deploy.sh as its default base URL. Apex is canonical
# (www redirects to it, see provision.sh) — use the apex here, not www.
LAYS_SITE_URL="https://laysmortorlor.com"
